PORT
DATABASE_URL
WORKOS_CLIENT_ID
WORKOS_API_KEY
WORKOS_CONNECTION
WORKOS_REDIRECT_URL
JWT_SECRET
RESEND_API_KEY
TOKEN_TIME_EXPIRED
FRONTEND_URL
HUBSPOT_ACCESS_TOKEN
HUBSPOT_CLIENT_SECRET
HUBSPOT_CUSTOM_OBJECT
HUBSPOT_CUSTOM_PIPELINE
GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI
GOOGLE_ACCESS_TOKEN
GOOGLE_REFRESH_TOKEN
OPENAI_API_KEY
OPENAI_API_KEY_RESUME_EXTRACTION

# Local dev only — in Lambda poppler comes from a layer mounted at /opt/bin.
# Leave unset to let node-poppler auto-discover a system install via `which`.
# Only set it if auto-discovery picks the wrong binary.
# macOS ARM: /opt/homebrew/bin | macOS Intel: /usr/local/bin
POPPLER_BIN_PATH

BILLCOM_USERNAME
BILLCOM_PASSWORD
BILLCOM_ORGANIZATION_ID
BILLCOM_DEV_KEY
BILLCOM_FUNDING_ACCOUNT_ID
BILLCOM_BASE_URL
BILLCOM_WEBHOOK_SECRET

PEER_ENV_API_URL= "oposite-env-api-url"
INTER_ENV_SYNC_SECRET= "shared-secret-between-envs"

# OpenRouter fallback — engages only when OpenAI reports insufficient_quota.
# Without OPENROUTER_API_KEY the fallback is disabled and behaviour is unchanged.
OPENROUTER_API_KEY
OPENROUTER_FALLBACK_ENABLED= "true"
OPENROUTER_HTTP_REFERER= "https://medvirtual.ai"
OPENROUTER_X_TITLE= "MedVirtual"
# Comma-separated cascades; leave unset to use the built-in free-model defaults
OPENROUTER_VISION_MODELS
OPENROUTER_TEXT_MODELS
OPENROUTER_IMAGE_MODEL= "google/gemini-2.5-flash-image"
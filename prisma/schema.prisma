generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL") // LOCAL_DATABASE_URL || DATABASE_URL
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model USER {
  id                     String              @id @default(uuid())
  email                  String              @unique
  organization_id        String?
  organization_name      String
  first_name             String
  last_name              String
  phone                  String
  avatar                 String
  job_title              String
  role                   String
  workos_id              String
  password               String              @db.VarChar(255)
  authentication_method  String
  status                 String
  verified               Boolean             @default(false)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  is_organization_owner  Boolean             @default(false)
  email_invitations      EmailInvitation[]
  email_verifications    EmailVerification[]
  hireRequestsAssigned   HireRequest[]       @relation("AssignedUser")
  adminOrganizations     Organization[]      @relation("OrganizationAdmin")
  ownedOrganizations     Organization[]      @relation("OrganizationOwner")
  conciergeOrganizations Organization[]      @relation("OrganizationConcierge")
  sessions               Session[]
  tickets                Ticket[]
  organization           Organization?       @relation(fields: [organization_id], references: [id])

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@index([organization_id], map: "idx_users_organization_id")
  @@index([status], map: "idx_users_status")
  @@index([is_organization_owner], map: "idx_users_is_organization_owner")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String
  createdAt DateTime @default(now())
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  user      USER     @relation(fields: [userId], references: [id])
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  verified  Boolean  @default(false)
  user      USER     @relation(fields: [userId], references: [id])
}

model EmailInvitation {
  id         String   @id @default(uuid())
  userId     String
  code       String
  email_from String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  verified   Boolean  @default(false)
  user       USER     @relation(fields: [userId], references: [id])
}

model Organization {
  id                   String             @id @default(uuid())
  name                 String
  email                String?             @unique
  phone                String?
  website_url          String?
  location             String?
  description          String?
  industry             String?
  organization_role    OrganizationRole   @default(prospect)
  number_of_employees  Int?
  date_founded         DateTime?
  date_joined          DateTime?
  date_became_client   DateTime?
  status               OrganizationStatus @default(active)
  signed_document_url  String?
  signed_document_date DateTime?
  hubspot_id           String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relationships
  owner_id     String? @unique // One owner per organization
  concierge_id String? // Assigned system admin/super admin
  admin_id     String? @default("") // Legacy field, consider removing

  // Many-to-many relationships
  specialties             String[]
  services                String[]
  users                   USER[] // All users in the organization
  organization_candidates OrganizationCandidate[]
  hire_requests           HireRequest[]
  tickets                 Ticket[]

  // Relations
  owner     USER? @relation("OrganizationOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  concierge USER? @relation("OrganizationConcierge", fields: [concierge_id], references: [id], onDelete: Restrict)
  admin     USER? @relation("OrganizationAdmin", fields: [admin_id], references: [id], onDelete: Restrict)

  @@index([hubspot_id], map: "idx_organizations_hubspot_id")
  @@index([status], map: "idx_organizations_status")
  @@index([name], map: "idx_organizations_name")
  @@index([admin_id], map: "idx_organizations_admin_id")
  @@index([owner_id], map: "idx_organizations_owner_id")
  @@index([concierge_id], map: "idx_organizations_concierge_id")
  @@index([organization_role], map: "idx_organizations_role")
  @@index([industry], map: "idx_organizations_industry")
}

model Candidate {
  id                     String                  @id @default(uuid())
  hubspot_id             String                  @unique
  email                  String
  first_name             String?
  last_name              String?
  resume_url             String?
  about_me               String?
  processed_resume_data  Json?
  processing_status      ProcessingStatus        @default(pending)
  processing_error       String?
  processed_at           DateTime?
  createdAt              DateTime                @default(now())
  hourly_pay_rate        Decimal?
  organization_id        String?
  pipeline_status        String                  @default("available")
  pipeline_status_origin String?                  
  years_of_experience    Int?
  country                String?
  specialization         String?
  employment_type        String?
  name                   String?
  medical_tools          String?
  tools                  String?
  gender                 String?
  educations             CandidateEducation[]
  experiences            CandidateExperience[]
  languages              CandidateLanguage[]
  skills                 CandidateSkill[]
  selectedInInterviews   Interview[]             @relation("SelectedCandidate")
  organizationCandidates OrganizationCandidate[]
  panelCandidates        PanelCandidate[]
  staff                  Staff[]
  tickets                Ticket[]
}

model CandidateLanguage {
  id           String    @id @default(uuid())
  candidate_id String
  name         String
  createdAt    DateTime  @default(now())
  candidate    Candidate @relation(fields: [candidate_id], references: [id])
}

model OrganizationCandidate {
  id              String       @id @default(uuid())
  organization_id String
  candidate_id    String
  pipeline_status String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  candidate       Candidate    @relation(fields: [candidate_id], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])
}

model CandidateSkill {
  id                String            @id @default(uuid())
  candidate_id      String
  skill_name        String
  proficiency_level ProficiencyLevel?
  skill_type        SkillType         @default(technical)
  createdAt         DateTime          @default(now())
  candidate         Candidate         @relation(fields: [candidate_id], references: [id])

  @@unique([candidate_id, skill_name, skill_type], name: "idx_candidate_skills_unique")
  @@index([candidate_id], map: "idx_candidate_skills_candidate_id")
  @@index([skill_name], map: "idx_candidate_skills_skill_name")
  @@index([skill_type], map: "idx_candidate_skills_skill_type")
}

model CandidateExperience {
  id               String    @id @default(uuid())
  candidate_id     String
  company          String
  position         String
  createdAt        DateTime  @default(now())
  responsabilities String?
  end_date         DateTime?
  start_date       DateTime?
  candidate        Candidate @relation(fields: [candidate_id], references: [id])

  @@index([candidate_id], map: "idx_candidate_experience_candidate_id")
  @@index([company], map: "idx_candidate_experience_company")
  @@index([position], map: "idx_candidate_experience_position")
}

model CandidateEducation {
  id           String    @id @default(uuid())
  candidate_id String
  degree       String
  institution  String
  year         String?
  createdAt    DateTime  @default(now())
  candidate    Candidate @relation(fields: [candidate_id], references: [id])

  @@index([candidate_id], map: "idx_candidate_education_candidate_id")
  @@index([institution], map: "idx_candidate_education_institution")
  @@index([year], map: "idx_candidate_education_year")
}

model HireRequest {
  id                  String             @id @default(uuid())
  org_id              String
  title               String
  description         String?
  status              HireRequestStatus  @default(new)
  priority            Priority           @default(medium)
  createdAt           DateTime           @default(now())
  availability        String
  contract_length     String?
  expected_start_date DateTime?
  salary_range_from   Decimal?
  salary_range_to     Decimal?
  specialization      String
  location            String?
  assign_user_id      String?
  panels              CandidatePanel[]
  assigned_user       USER?              @relation("AssignedUser", fields: [assign_user_id], references: [id])
  organization        Organization       @relation(fields: [org_id], references: [id])
  skills              HireRequestSkill[]
  staff               Staff[]

  @@index([org_id], map: "idx_hire_requests_org_id")
  @@index([status], map: "idx_hire_requests_status")
  @@index([priority], map: "idx_hire_requests_priority")
  @@index([createdAt], map: "idx_hire_requests_createdAt")
}

model HireRequestSkill {
  id              String           @id @default(uuid())
  hire_request_id String
  skill_name      String
  required_level  ProficiencyLevel @default(intermediate)
  createdAt       DateTime         @default(now())
  hireRequest     HireRequest      @relation(fields: [hire_request_id], references: [id], onDelete: Cascade)

  @@unique([hire_request_id, skill_name], name: "idx_hire_request_skills_unique")
  @@index([hire_request_id], map: "idx_hire_request_skills_hire_request_id")
  @@index([skill_name], map: "idx_hire_request_skills_skill_name")
}

model CandidatePanel {
  id              String           @id @default(uuid())
  hire_request_id String
  status          PanelStatus      @default(created)
  scheduled_date  DateTime?
  createdAt       DateTime         @default(now())
  readable        Boolean          @default(false)
  hireRequest     HireRequest      @relation(fields: [hire_request_id], references: [id], onDelete: Cascade)
  interviews      Interview[]
  panelCandidates PanelCandidate[]

  @@index([hire_request_id], map: "idx_candidate_panels_hire_request_id")
  @@index([status], map: "idx_candidate_panels_status")
  @@index([scheduled_date], map: "idx_candidate_panels_scheduled_date")
}

model PanelCandidate {
  id           String               @id @default(uuid())
  panel_id     String
  candidate_id String
  status       PanelCandidateStatus @default(selected)
  createdAt    DateTime             @default(now())
  candidate    Candidate            @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  panel        CandidatePanel       @relation(fields: [panel_id], references: [id], onDelete: Cascade)

  @@unique([panel_id, candidate_id], name: "idx_panel_candidates_unique")
  @@index([panel_id], map: "idx_panel_candidates_panel_id")
  @@index([candidate_id], map: "idx_panel_candidates_candidate_id")
  @@index([status], map: "idx_panel_candidates_status")
}

model Interview {
  id                    String          @id @default(uuid())
  panel_id              String
  scheduled_date        DateTime
  duration              Int
  status                InterviewStatus @default(scheduled)
  notes                 String?
  selected_candidate_id String?
  decision_date         DateTime?
  expires_at            DateTime?
  createdAt             DateTime        @default(now())
  panel                 CandidatePanel  @relation(fields: [panel_id], references: [id], onDelete: Cascade)
  selectedCandidate     Candidate?      @relation("SelectedCandidate", fields: [selected_candidate_id], references: [id])

  @@index([panel_id], map: "idx_interviews_panel_id")
  @@index([scheduled_date], map: "idx_interviews_scheduled_date")
  @@index([status], map: "idx_interviews_status")
  @@index([selected_candidate_id], map: "idx_interviews_selected_candidate_id")
  @@index([expires_at], map: "idx_interviews_expires_at")
}

model Ticket {
  id           String       @id @default(uuid())
  user_id      String?
  title        String
  description  String
  status       TicketStatus @default(new)
  createdAt    DateTime     @default(now())
  type         String
  org_id       String
  priority     Priority
  staff_id     String?
  candidate_id String?
  organization Organization @relation(fields: [org_id], references: [id])
  staff        Staff?       @relation(fields: [staff_id], references: [id])
  user         USER?        @relation(fields: [user_id], references: [id])
  candidate    Candidate?   @relation(fields: [candidate_id], references: [id])

  @@index([user_id], map: "idx_tickets_user_id")
  @@index([type], map: "idx_tickets_type")
  @@index([status], map: "idx_tickets_status")
  @@index([createdAt], map: "idx_tickets_createdAt")
  @@index([candidate_id], map: "idx_tickets_candidate_id")
}

model GoogleToken {
  id           String   @id @default(uuid())
  accessToken  String
  refreshToken String
  scope        String?
  tokenType    String?
  expiryDate   BigInt?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Staff {
  id              String      @id @default(uuid())
  candidate_id    String
  hirerequest_id  String
  status          String
  salary          Decimal?
  start_date      DateTime?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  created_by      String?
  terminated_date DateTime?
  bonus           Bonus[]
  candidate       Candidate   @relation(fields: [candidate_id], references: [id])
  hireRequest     HireRequest @relation(fields: [hirerequest_id], references: [id])
  tickets         Ticket[]

  @@index([candidate_id], map: "idx_staff_candidate_id")
  @@index([hirerequest_id], map: "idx_staff_hirerequest_id")
  @@index([status], map: "idx_staff_status")
}

model Bonus {
  id          String   @id @default(uuid())
  staff_id    String
  amount      Decimal
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  created_by  String?
  staff       Staff    @relation(fields: [staff_id], references: [id])

  @@index([staff_id], map: "idx_bonus_staff_id")
}

enum Role {
  organization_admin
  organization_super_admin
  system_admin
  system_super_admin
}

enum UserStatus {
  incomplete
  active
  inactive
  deleted
  prospect
  pending_verification
  suspended
}

enum CandidateStatus {
  available
}

enum ProcessingStatus {
  pending
  processing_downloadFile
  processing_uploadFile
  processing_extractData
  processing_extractText
  processing_organizeData
  processing_updateCandidate
  completed
  failed
}

enum ProficiencyLevel {
  beginner
  intermediate
  advanced
  expert
}

enum SkillType {
  technical
  soft
  language
  certification
}

enum HireRequestStatus {
  new
  pending_signature
  sourcing
  panel_ready
  interview_scheduled
  awaiting_decision
  placement_completed
  cancelled
}

enum Priority {
  low
  medium
  high
}

enum PanelStatus {
  created
  interview_scheduled
  interview_completed
  decision_pending
  decision_made
  expired
}

enum PanelCandidateStatus {
  selected
  interviewed
  selected_by_client
  returned_to_pool
}

enum InterviewStatus {
  scheduled
  completed
  cancelled
}

enum TicketStatus {
  new
  in_progress
  resolved
  closed
}

enum OrganizationRole {
  prospect
  client
}

enum OrganizationStatus {
  active
  inactive
}

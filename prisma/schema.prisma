generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model USER {
  id                           String                       @id @default(uuid())
  email                        String                       @unique
  organization_id              String?
  organization_name            String
  first_name                   String
  last_name                    String
  phone                        String
  avatar                       String
  job_title                    String
  role                         String
  workos_id                    String
  password                     String                       @db.VarChar(255)
  authentication_method        String
  status                       String
  verified                     Boolean                      @default(false)
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  is_organization_owner        Boolean                      @default(false)
  createdByMethod              String                       @default("self_signup")
  createdByUserId              String?
  hubspot_id                   String?                      @unique
  hubspot_contact_id           String?                      @unique
  status_before_deactivation   String?
  activatedAt                  DateTime?
  commissionAdminDecisions     AffiliateCommission[]        @relation("CommissionAdminDecision")
  affiliateCommissions         AffiliateCommission[]        @relation("AffiliateCommissions")
  payoutRequestsAsAffiliate    AffiliatePayoutRequest[]     @relation("AffiliatePayoutRequests")
  payoutApprovals              AffiliatePayoutRequest[]     @relation("PayoutApprovedBy")
  payoutCancellations          AffiliatePayoutRequest[]     @relation("PayoutCancelledBy")
  payoutReviews                AffiliatePayoutRequest[]     @relation("PayoutReviewedBy")
  affiliateProfile             AffiliateProfile?
  Contact                      Contact?
  email_invitations            EmailInvitation[]
  email_verifications          EmailVerification[]
  hireRequestsSourcingAssigned HireRequest[]                @relation("AssignedSourcing")
  hireRequestsStaffingAssigned HireRequest[]                @relation("AssignedStaffing")
  hireRequestsCreated          HireRequest[]                @relation("HireRequestCreatedBy")
  HubspotAuditLog              HubspotAuditLog[]
  resolvedReviewCases          MedAllianceAdminReviewCase[] @relation("ReviewCaseResolvedBy")
  medAllianceAuditActorLogs    MedAllianceAuditLog[]        @relation("MedAllianceAuditActor")
  adminOrganizations           Organization[]               @relation("OrganizationAdmin")
  ownedOrganizations           Organization[]               @relation("OrganizationOwner")
  referToOrganizations         Organization[]               @relation("OrganizationReferTo")
  referredOrganizations        Organization[]               @relation("OrganizationReferredBy")
  panelCandidatesCreated       PanelCandidate[]             @relation("PanelCandidateCreatedBy")
  PasswordResetTokens          PasswordResetToken[]
  payoutRequestNotes           PayoutRequestNote[]          @relation("PayoutRequestNoteAuthor")
  sessions                     Session[]
  talentPoolLeads              TalentPoolLead[]
  ticketsCreated               Ticket[]                     @relation("TicketCreatedBy")
  tickets                      Ticket[]
  TicketNotes                  TicketNotes[]
  createdBy                    USER?                        @relation("UserCreatedBy", fields: [createdByUserId], references: [id])
  createdUsers                 USER[]                       @relation("UserCreatedBy")
  organization                 Organization?                @relation(fields: [organization_id], references: [id])
  hireRequestsAssignedMany     HireRequest[]                @relation("AssignedUsers")
  invoicesCreated             Invoice[]                    @relation("InvoiceCreatedBy")
  invoicesVoided              Invoice[]                    @relation("InvoiceVoidedBy")
  invoiceVersionsReviewed     InvoiceVersion[]             @relation("InvoiceVersionReviewedBy")
  invoiceVersionsApproved     InvoiceVersion[]             @relation("InvoiceVersionApprovedBy")
  invoiceVersionsPublished    InvoiceVersion[]             @relation("InvoiceVersionPublishedBy")
  invoiceVersionsCreated      InvoiceVersion[]             @relation("InvoiceVersionCreatedBy")
  invoiceLinesCreated         InvoiceLineItem[]            @relation("InvoiceLineCreatedBy")
  invoiceLineAdjustments      InvoiceLineAdjustmentHistory[] @relation("InvoiceLineAdjustmentChangedBy")
  invoiceReconciliationsCreated InvoiceLineReconciliation[] @relation("InvoiceReconCreatedBy")
  invoiceReviewsSubmitted     InvoiceReview[]              @relation("InvoiceReviewSubmittedBy")
  invoiceReviewsReviewed      InvoiceReview[]              @relation("InvoiceReviewReviewedBy")
  invoiceComments             InvoiceComment[]             @relation("InvoiceCommentAuthor")
  invoiceAuditActorLogs       InvoiceAuditLog[]            @relation("InvoiceAuditActor")

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@index([organization_id], map: "idx_users_organization_id")
  @@index([status], map: "idx_users_status")
  @@index([is_organization_owner], map: "idx_users_is_organization_owner")
  @@index([createdByMethod], map: "idx_users_created_by_method")
  @@index([createdByUserId], map: "idx_users_created_by_user_id")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String
  createdAt DateTime @default(now())
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  user      USER     @relation(fields: [userId], references: [id])
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  verified  Boolean  @default(false)
  user      USER     @relation(fields: [userId], references: [id])
}

model EmailInvitation {
  id         String   @id @default(uuid())
  userId     String
  code       String
  email_from String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  verified   Boolean  @default(false)
  user       USER     @relation(fields: [userId], references: [id])
}

model Organization {
  id                           String                       @id @default(uuid())
  name                         String
  email                        String?
  hubspot_id                   String?                      @unique
  createdAt                    DateTime                     @default(now())
  admin_id                     String?
  description                  String?
  owner_id                     String?
  date_became_client           DateTime?
  date_founded                 DateTime?
  date_joined                  DateTime?
  industry                     String?
  location                     String?
  number_of_employees          Int?
  organization_role            OrganizationRole             @default(prospect)
  phone                        String?
  services                     String[]
  signed_document_date         DateTime?
  signed_document_url          String?
  updatedAt                    DateTime                     @updatedAt
  website_url                  String?
  status                       OrganizationStatus           @default(active)
  specialties                  String[]
  address                      String?
  city                         String?
  postal_code                  String?
  state                        String?
  business_unit                String?
  source                       String?
  type                         String?
  deletedAt                    DateTime?
  referred_by_affiliate_id     String?
  med_alliance_block_reason    String?
  med_alliance_referral_status MedAllianceReferralStatus?
  hubspot_sync_error           String?
  hubspot_sync_status          String?
  hubspot_synced_at            DateTime?
  contact_first_name           String?
  contact_last_name            String?
  refer_to_user_id             String?
  contact_email                String?
  eligibility_start_at         DateTime?
  first_paid_invoice_at        DateTime?
  referral_stage               ReferralStage?               @default(referred)
  affiliateCommissions         AffiliateCommission[]
  Contact                      Contact[]
  hire_requests                HireRequest[]
  hubspotInvoiceSnapshots      HubspotInvoiceSnapshot[]
  adminReviewCases             MedAllianceAdminReviewCase[]
  invoiceConfiguration         InvoiceConfiguration?
  admin                        USER?                        @relation("OrganizationAdmin", fields: [admin_id], references: [id], onDelete: Restrict)
  owner                        USER?                        @relation("OrganizationOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  referToUser                  USER?                        @relation("OrganizationReferTo", fields: [refer_to_user_id], references: [id])
  referredByAffiliate          USER?                        @relation("OrganizationReferredBy", fields: [referred_by_affiliate_id], references: [id])
  organization_candidates      OrganizationCandidate[]
  staff                        Staff[]
  tickets                      Ticket[]
  users                        USER[]
  invoices                    Invoice[]
  invoiceLineReconciliations  InvoiceLineReconciliation[]
  billingLedgerEntries        BillingLedgerEntry[]

  @@index([hubspot_id], map: "idx_organizations_hubspot_id")
  @@index([status], map: "idx_organizations_status")
  @@index([name], map: "idx_organizations_name")
  @@index([admin_id], map: "idx_organizations_admin_id")
  @@index([owner_id], map: "idx_organizations_owner_id")
  @@index([organization_role], map: "idx_organizations_role")
  @@index([industry], map: "idx_organizations_industry")
  @@index([referred_by_affiliate_id], map: "idx_organizations_referred_by")
  @@index([referred_by_affiliate_id, status], map: "idx_organizations_affiliate_status")
  @@index([refer_to_user_id], map: "idx_organizations_refer_to_user")
  @@index([referral_stage, eligibility_start_at], map: "idx_organizations_referral_stage")
}

model Candidate {
  id                                                              String                  @id @default(uuid())
  hubspot_id                                                      String                  @unique
  email                                                           String
  first_name                                                      String?
  last_name                                                       String?
  resume_url                                                      String?
  about_me                                                        String?
  processed_resume_data                                           Json?
  processing_status                                               ProcessingStatus        @default(pending)
  processing_error                                                String?
  processed_at                                                    DateTime?
  createdAt                                                       DateTime                @default(now())
  hourly_pay_rate                                                 Decimal?
  organization_id                                                 String?
  pipeline_status                                                 String                  @default("available")
  years_of_experience                                             Int?
  country                                                         String?
  specialization                                                  String?
  employment_type                                                 String?
  name                                                            String?
  medical_tools                                                   String?
  tools                                                           String?
  gender                                                          String?
  pipeline_status_origin                                          String?
  approved_positions_pairing                                      String[]
  processing_cost                                                 Decimal?                @default(0)
  avatar_url                                                      String?
  headshot_url                                                    String?
  shift_block                                                     String?
  video_link                                                      String?
  business_unit                                                   String?
  active_listening_and_comprehension_demonstrated                 String?
  adaptability_to_different_client_personalities_and_workflows    String?
  can_articulate_experience_clearly_to_clients                    String?
  can_multitask_between_systems_or_windows_efficiently            String?
  client_readiness___fit_evaluator_notes                          String?
  comfortable_with_camera_on_setup                                String?
  communication_skills_evaluator_notes                            String?
  confident_on_video_and_phone_calls                              String?
  cultural_alignment_with_us_healthcare_environment               String?
  demonstrates_problem_solving_and_tech_adaptability              String?
  demonstrates_stability_and_commitment                           String?
  exhibits_confidence_and_empathy_in_roleplay_scenarios           String?
  for_bilinguals__fluent_and_accurate_in_both_english_and_spanish String?
  grammar__vocabulary__and_tone_are_appropriate_for_us_clients    String?
  handles_feedback_constructively                                 String?
  has_functioning_headset__webcam__and_backup_device              String?
  knowledge_of_hipaa_compliance_and_confidentiality               String?
  medical_knowledge_evaluator_notes                               String?
  no_medical_industry_experience                                  String?
  positive_attitude_and_professional_demeanor                     String?
  prior_experience_in_healthcare_or_medical_va_roles              String?
  professionalism___work_readiness_evaluator_notes                String?
  punctual_and_responsive_during_recruitment_stages               String?
  remote_work_discipline_and_time_management                      String?
  speaks_clearly_and_professionally                               String?
  stable_internet_connection__min__20_mbps_                       String?
  technical_competence_evaluator_notes                            String?
  tier_level                                                      String?
  total_points                                                    String?
  description_summary                                             String?
  updatedAt                                                       DateTime                @default(now())
  comfortable_with_basic_tools__google_workspace__zoom__ehr_softw String?
  demonstrates_understanding_of_medical_terminology_and_procedure String?
  familiarity_with_emr_ehr_systems__kareo__athena__eclinicalworks String?
  understands_workflow_in_medical_offices___telehealth_environmen String?
  educations                                                      CandidateEducation[]
  experiences                                                     CandidateExperience[]
  languages                                                       CandidateLanguage[]
  skills                                                          CandidateSkill[]
  selectedInInterviews                                            Interview[]             @relation("SelectedCandidate")
  organizationCandidates                                          OrganizationCandidate[]
  panelCandidates                                                 PanelCandidate[]
  staff                                                           Staff[]
  tickets                                                         Ticket[]
}

model CandidateLanguage {
  id           String    @id @default(uuid())
  candidate_id String
  name         String
  createdAt    DateTime  @default(now())
  candidate    Candidate @relation(fields: [candidate_id], references: [id])
}

model OrganizationCandidate {
  id              String       @id @default(uuid())
  organization_id String
  candidate_id    String
  pipeline_status String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  candidate       Candidate    @relation(fields: [candidate_id], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])
}

model CandidateSkill {
  id                String            @id @default(uuid())
  candidate_id      String
  skill_name        String
  proficiency_level ProficiencyLevel?
  skill_type        SkillType         @default(technical)
  createdAt         DateTime          @default(now())
  candidate         Candidate         @relation(fields: [candidate_id], references: [id])

  @@unique([candidate_id, skill_name, skill_type], name: "idx_candidate_skills_unique")
  @@index([candidate_id], map: "idx_candidate_skills_candidate_id")
  @@index([skill_name], map: "idx_candidate_skills_skill_name")
  @@index([skill_type], map: "idx_candidate_skills_skill_type")
}

model CandidateExperience {
  id               String    @id @default(uuid())
  candidate_id     String
  company          String
  position         String
  createdAt        DateTime  @default(now())
  responsabilities String?
  end_date         DateTime?
  start_date       DateTime?
  candidate        Candidate @relation(fields: [candidate_id], references: [id])

  @@index([candidate_id], map: "idx_candidate_experience_candidate_id")
  @@index([company], map: "idx_candidate_experience_company")
  @@index([position], map: "idx_candidate_experience_position")
}

model CandidateEducation {
  id           String    @id @default(uuid())
  candidate_id String
  degree       String
  institution  String
  year         String?
  createdAt    DateTime  @default(now())
  candidate    Candidate @relation(fields: [candidate_id], references: [id])

  @@index([candidate_id], map: "idx_candidate_education_candidate_id")
  @@index([institution], map: "idx_candidate_education_institution")
  @@index([year], map: "idx_candidate_education_year")
}

model HireRequest {
  id                                       String             @id @default(uuid())
  org_id                                   String
  title                                    String
  description                              String?
  status                                   HireRequestStatus  @default(new)
  priority                                 Priority           @default(medium)
  createdAt                                DateTime           @default(now())
  availability                             String
  contract_length                          String?
  expected_start_date                      DateTime?
  salary_range_from                        Decimal?
  salary_range_to                          Decimal?
  specialization                           String?
  location                                 String?
  assign_user_id                           String?
  createdByUserId                          String?
  hubspot_contract_amount                  Decimal?
  hubspot_language                         String?
  hubspot_numberVA                         Int?
  hubspot_role_type                        String?
  hubspot_ticket_id                        String?            @unique
  hubspot_business_unit                    String?
  hubspot_company_name                     String?
  hubspot_company_url                      String?
  hubspot_pairing_request_type             String?
  hubspot_pipeline                         String?
  hubspot_pipeline_stage                   String?
  hubspot_ticket_type                      String?
  assign_sourcing_id                       String?
  old_status                               HireRequestStatus?
  hubspot_n2_monitors_required             String?
  hubspot_special_requirements             String?
  hubspot_special_sourcing_needed          String?
  hubspot_tasks                            String?
  hubspot_va_shift_hours                   String?
  hubspot_additional_training_requested    String?
  hubspot_pairing_date                     String?
  hubspot_pairing_time                     String?
  cancel_date                              DateTime?
  cancel_reason                            String?
  request_role                             String?
  hubspot_camera_on_during_shift           String?
  hubspot_tools_familiarization            String?
  hubspot_training_request_notes           String?
  assign_staffing_coordinator              String?
  client_signed_contract_closing_ticket    String?
  client_signed_contract_ticket_submission String?
  description_summary                      String?
  summary_generated_at                     DateTime?
  hubspot_tasks_summary                    String?
  hubspot_tasks_summary_generated_at       DateTime?
  panels                                   CandidatePanel[]
  assigned_sourcing                        USER?              @relation("AssignedSourcing", fields: [assign_sourcing_id], references: [id])
  assigned_staffing                        USER?              @relation("AssignedStaffing", fields: [assign_staffing_coordinator], references: [id])
  createdBy                                USER?              @relation("HireRequestCreatedBy", fields: [createdByUserId], references: [id])
  organization                             Organization       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  skills                                   HireRequestSkill[]
  staff                                    Staff[]
  tickets                                  Ticket[]
  assigned_users                           USER[]             @relation("AssignedUsers")

  @@index([org_id], map: "idx_hire_requests_org_id")
  @@index([status], map: "idx_hire_requests_status")
  @@index([priority], map: "idx_hire_requests_priority")
  @@index([createdAt], map: "idx_hire_requests_createdAt")
  @@index([createdByUserId], map: "idx_hire_requests_created_by_user_id")
}

model HireRequestSkill {
  id              String           @id @default(uuid())
  hire_request_id String
  skill_name      String
  required_level  ProficiencyLevel @default(intermediate)
  createdAt       DateTime         @default(now())
  hireRequest     HireRequest      @relation(fields: [hire_request_id], references: [id], onDelete: Cascade)

  @@unique([hire_request_id, skill_name], name: "idx_hire_request_skills_unique")
  @@index([hire_request_id], map: "idx_hire_request_skills_hire_request_id")
  @@index([skill_name], map: "idx_hire_request_skills_skill_name")
}

model CandidatePanel {
  id              String           @id @default(uuid())
  hire_request_id String
  status          PanelStatus      @default(created)
  scheduled_date  DateTime?
  createdAt       DateTime         @default(now())
  readable        Boolean          @default(false)
  decided_date    DateTime?
  hireRequest     HireRequest      @relation(fields: [hire_request_id], references: [id], onDelete: Cascade)
  interviews      Interview[]
  panelCandidates PanelCandidate[]

  @@index([hire_request_id], map: "idx_candidate_panels_hire_request_id")
  @@index([status], map: "idx_candidate_panels_status")
  @@index([scheduled_date], map: "idx_candidate_panels_scheduled_date")
}

model PanelCandidate {
  id              String               @id @default(uuid())
  panel_id        String
  candidate_id    String
  status          PanelCandidateStatus @default(selected)
  createdAt       DateTime             @default(now())
  createdByUserId String?
  candidate       Candidate            @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  createdBy       USER?                @relation("PanelCandidateCreatedBy", fields: [createdByUserId], references: [id])
  panel           CandidatePanel       @relation(fields: [panel_id], references: [id], onDelete: Cascade)

  @@unique([panel_id, candidate_id], name: "idx_panel_candidates_unique")
  @@index([panel_id], map: "idx_panel_candidates_panel_id")
  @@index([candidate_id], map: "idx_panel_candidates_candidate_id")
  @@index([status], map: "idx_panel_candidates_status")
}

model Interview {
  id                    String          @id @default(uuid())
  panel_id              String
  scheduled_date        DateTime
  duration              Int
  status                InterviewStatus @default(scheduled)
  notes                 String?
  selected_candidate_id String?
  decision_date         DateTime?
  expires_at            DateTime?
  createdAt             DateTime        @default(now())
  alert_closed          Boolean         @default(false)
  link                  String?
  panel                 CandidatePanel  @relation(fields: [panel_id], references: [id], onDelete: Cascade)
  selectedCandidate     Candidate?      @relation("SelectedCandidate", fields: [selected_candidate_id], references: [id])

  @@index([panel_id], map: "idx_interviews_panel_id")
  @@index([scheduled_date], map: "idx_interviews_scheduled_date")
  @@index([status], map: "idx_interviews_status")
  @@index([selected_candidate_id], map: "idx_interviews_selected_candidate_id")
  @@index([expires_at], map: "idx_interviews_expires_at")
}

model Ticket {
  id             String        @id @default(uuid())
  user_id        String?
  title          String
  description    String
  status         TicketStatus  @default(new)
  createdAt      DateTime      @default(now())
  type           String
  org_id         String?
  priority       Priority
  staff_id       String?
  candidate_id   String?
  updatedAt      DateTime      @updatedAt
  created_by     String?
  hireRequest_id String?
  candidate      Candidate?    @relation(fields: [candidate_id], references: [id])
  createdBy      USER?         @relation("TicketCreatedBy", fields: [created_by], references: [id])
  hireRequest    HireRequest?  @relation(fields: [hireRequest_id], references: [id])
  organization   Organization? @relation(fields: [org_id], references: [id], onDelete: Cascade)
  staff          Staff?        @relation(fields: [staff_id], references: [id])
  user           USER?         @relation(fields: [user_id], references: [id])
  TicketNotes    TicketNotes[]

  @@index([user_id], map: "idx_tickets_user_id")
  @@index([type], map: "idx_tickets_type")
  @@index([status], map: "idx_tickets_status")
  @@index([createdAt], map: "idx_tickets_createdAt")
  @@index([updatedAt], map: "idx_tickets_updatedAt")
  @@index([candidate_id], map: "idx_tickets_candidate_id")
  @@index([created_by], map: "idx_tickets_created_by")
}

model GoogleToken {
  id           String   @id @default(uuid())
  accessToken  String
  refreshToken String
  scope        String?
  tokenType    String?
  expiryDate   BigInt?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Staff {
  id                      String        @id @default(uuid())
  candidate_id            String?
  hirerequest_id          String?
  status                  String
  salary                  Decimal?
  start_date              DateTime?
  created_at              DateTime      @default(now())
  updated_at              DateTime      @updatedAt
  created_by              String?
  terminated_date         DateTime?
  hubspot_client_name     String?
  hubspot_close_date      DateTime?
  hubspot_company_name    String?
  hubspot_deal_name       String?
  hubspot_dealstage       String?
  hubspot_dealtype        String?
  hubspot_deployment_type String?
  hubspot_description     String?
  hubspot_hs_acv          String?
  hubspot_id              String?       @unique
  hubspot_pipeline        String?
  hubspot_business_unit   String?
  hubspot_candidate_id    String?
  hubspot_organization_id String?
  organization_id         String?
  bonus                   Bonus[]
  candidate               Candidate?    @relation(fields: [candidate_id], references: [id])
  hireRequest             HireRequest?  @relation(fields: [hirerequest_id], references: [id])
  organization            Organization? @relation(fields: [organization_id], references: [id])
  tickets                 Ticket[]

  @@index([candidate_id], map: "idx_staff_candidate_id")
  @@index([hirerequest_id], map: "idx_staff_hirerequest_id")
  @@index([status], map: "idx_staff_status")
}

model Bonus {
  id          String   @id @default(uuid())
  staff_id    String
  amount      Decimal
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  created_by  String?
  staff       Staff    @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@index([staff_id], map: "idx_bonus_staff_id")
}

model Mail_Settings {
  id         String   @id @default(uuid())
  title      String
  created_at DateTime @default(now())
}

model Sync {
  id             String   @id @default(uuid())
  role           String
  last_synced_at DateTime
}

model TicketNotes {
  id          String    @id
  ticket_id   String
  author_id   String
  content     String
  is_internal Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  USER        USER      @relation(fields: [author_id], references: [id], onUpdate: NoAction)
  Ticket      Ticket    @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model TalentPoolLead {
  id                  String    @id @default(uuid())
  name                String    @db.VarChar(255)
  email               String    @db.VarChar(255)
  organization        String    @db.VarChar(255)
  main_need           String?
  additional_details  String?
  source              String    @db.VarChar(50)
  type                String    @default("Talent Pool Inquiry") @db.VarChar(50)
  status              String    @default("new") @db.VarChar(50)
  assigned_to_user_id String?
  notes               String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now())
  contacted_at        DateTime?

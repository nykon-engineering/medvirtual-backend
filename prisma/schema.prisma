model Bonus {
  id          String   @id @default(uuid())
  staff_id    String
  amount      Decimal
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  created_by  String?
  staff       Staff    @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@index([staff_id], map: "idx_bonus_staff_id")
}

model Mail_Settings {
  id         String   @id @default(uuid())
  title      String
  created_at DateTime @default(now())
}

model Sync {
  id             String   @id @default(uuid())
  role           String
  last_synced_at DateTime
}

model TicketNotes {
  id          String    @id
  ticket_id   String
  author_id   String
  content     String
  is_internal Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  USER        USER      @relation(fields: [author_id], references: [id], onUpdate: NoAction)
  Ticket      Ticket    @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
